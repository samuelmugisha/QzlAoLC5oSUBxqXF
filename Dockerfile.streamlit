# Bitcoin trading agent — Streamlit dashboard image
#
# Separate from the main Dockerfile (which builds the scheduler) because
# DigitalOcean App Platform bakes the run command into the image for
# Docker-sourced components — one Dockerfile per component/process type.
FROM python:3.11-slim

WORKDIR /app

# Install dependencies first so this layer is cached across code changes.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code.
COPY src/ ./src/
COPY streamlit_app.py .

RUN mkdir -p /app/data /app/config

# Secrets are injected as environment variables at deploy time — never
# baked into the image. See README / config_manager.py for the full list.
ENV PYTHONUNBUFFERED=1

# App Platform injects $PORT at runtime (defaults to 8080); Streamlit
# must bind to 0.0.0.0 on that port to be reachable.
EXPOSE 8080
CMD streamlit run streamlit_app.py \
    --server.port=${PORT:-8080} \
    --server.address=0.0.0.0 \
    --server.headless=true \
    --server.enableCORS=false \
    --server.enableXsrfProtection=false
